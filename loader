---------------------------------------------------------
-- ПРОВЕРКА КЛЮЧА И ЗАПУСК
---------------------------------------------------------
loadBtn.MouseButton1Click:Connect(function()
    local inputKey = keyBox.Text:gsub("%s+", "")
    if inputKey == "" then
        loadBtn.Text = "Enter Key First!"
        task.wait(1.2)
        loadBtn.Text = "Check Key"
        return
    end

    loadBtn.Text = "Validating..."

    task.spawn(function()
        if not requestFunc then
            loadBtn.Text = "Executor Not Supported!"
            task.wait(1.5)
            loadBtn.Text = "Check Key"
            return
        end

        local payload = {
            key = inputKey:upper(),
            hwid = RbxAnalyticsService:GetClientId()
        }

        local success, response = pcall(function()
            return requestFunc({
                Url = API_URL,
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json"
                },
                Body = HttpService:JSONEncode(payload)
            })
        end)

        if not success or not response or not response.Body then
            loadBtn.Text = "Server Error!"
            task.wait(1.5)
            loadBtn.Text = "Check Key"
            return
        end

        local resBody = response.Body

        if resBody:find("<!DOCTYPE") or resBody:find("<html") or resBody:find("aes.js") then
            loadBtn.Text = "Host Anti-Bot Error!"
            task.wait(1.5)
            loadBtn.Text = "Check Key"
            return
        end

        local isJson, decoded = pcall(function()
            return HttpService:JSONDecode(resBody)
        end)

        if isJson and type(decoded) == "table" and decoded.status == "success" then
            loadBtn.Text = decoded.message or "Access Granted!"
            task.wait(1.5)
            gui:Destroy()
            OnKeyVerified()
        else
            local errorMsg = (isJson and decoded and decoded.message) or "Invalid / Expired Key!"
            loadBtn.Text = errorMsg
            task.wait(2)
            loadBtn.Text = "Check Key"
        end
    end)
end)
