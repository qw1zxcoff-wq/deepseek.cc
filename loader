-- НАСТРОЙКИ ВЕБ-САЙТА И ЗАГРУЗКИ
---------------------------------------------------------
local API_URL = "https://fancy-scene-5d50.qweasdww58.workers.dev"

-- Прямая ссылка (RAW) на ваш основной скрипт
local SCRIPT_URL = "https://raw.githubusercontent.com/qw1zxcoff-wq/deepseek.cc/refs/heads/main/deepseek.cc"

local requestFunc = request or http_request or (syn and syn.request) or (http and http.request)

local function OnKeyVerified()
    print("[deepseek.cc] Ключ успешно подтверждён! Загрузка основного скрипта...")
    
    -- Загрузка и запуск основного скрипта
    task.spawn(function()
        local success, err = pcall(function()
            loadstring(game:HttpGet(SCRIPT_URL))()
        end)
        
        if not success then
            warn("[deepseek.cc] Ошибка выполнения основного скрипта: " .. tostring(err))
        end
    end)
end

